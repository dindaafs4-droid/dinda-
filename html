<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dinda - Keuangan Jajan</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 50%, #f48fb1 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 30px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            max-width: 450px;
            width: 100%;
            padding: 30px 25px;
        }

        /* Header */
        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 3rem;
            font-weight: 800;
            background: linear-gradient(135deg, #e91e63, #c2185b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 2px;
            margin-bottom: 5px;
        }

        .header .subtitle {
            font-size: 0.9rem;
            color: #ad1457;
            font-weight: 500;
        }

        .header .emoji {
            font-size: 1.2rem;
        }

        /* Menu Grid */
        .menu-section {
            margin-bottom: 25px;
        }

        .menu-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #880e4f;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .menu-card {
            background: #fff5f8;
            border: 2px solid #f8bbd0;
            border-radius: 20px;
            padding: 18px 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 0 #f48fb1;
            user-select: none;
            position: relative;
        }

        .menu-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 0 #f06292;
        }

        .menu-card:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #ec407a;
        }

        .menu-card.selected {
            background: #fce4ec;
            border-color: #e91e63;
            box-shadow: 0 2px 0 #c2185b;
            transform: translateY(2px);
        }

        .menu-card .menu-icon {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 8px;
        }

        .menu-card .menu-name {
            font-weight: 700;
            font-size: 1rem;
            color: #880e4f;
            display: block;
            margin-bottom: 4px;
        }

        .menu-card .menu-price {
            font-weight: 600;
            font-size: 0.8rem;
            color: #e91e63;
            background: #fce4ec;
            padding: 3px 14px;
            border-radius: 20px;
            display: inline-block;
        }

        .menu-card.selected .menu-price {
            background: #e91e63;
            color: white;
        }

        /* Quantity */
        .qty-section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff5f8;
            border-radius: 50px;
            padding: 10px 18px;
            margin-bottom: 18px;
            border: 2px solid #f8bbd0;
        }

        .qty-label {
            font-weight: 700;
            color: #880e4f;
            font-size: 0.95rem;
        }

        .qty-control {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .qty-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: none;
            background: #f48fb1;
            color: white;
            font-size: 1.3rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qty-btn:hover {
            background: #f06292;
        }

        .qty-btn:active {
            transform: scale(0.9);
            background: #ec407a;
        }

        #quantityDisplay {
            font-size: 1.4rem;
            font-weight: 700;
            min-width: 35px;
            text-align: center;
            color: #880e4f;
        }

        /* Add Button */
        .add-btn {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 50px;
            background: linear-gradient(135deg, #e91e63, #c2185b);
            color: white;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 6px 0 #880e4f;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }

        .add-btn:hover {
            background: linear-gradient(135deg, #f06292, #d81b60);
        }

        .add-btn:active {
            transform: translateY(3px);
            box-shadow: 0 3px 0 #6a1b3a;
        }

        /* Cart */
        .cart-section {
            background: #fff5f8;
            border-radius: 25px;
            padding: 18px 16px;
            border: 2px solid #f8bbd0;
        }

        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .cart-title {
            font-weight: 700;
            color: #880e4f;
            font-size: 0.95rem;
        }

        .reset-btn {
            background: white;
            border: 2px solid #f48fb1;
            color: #c2185b;
            padding: 7px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .reset-btn:hover {
            background: #fce4ec;
        }

        .reset-btn:active {
            background: #f8bbd0;
        }

        .cart-items {
            list-style: none;
            max-height: 200px;
            overflow-y: auto;
            margin-bottom: 10px;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            border-radius: 15px;
            padding: 10px 14px;
            margin-bottom: 8px;
            border: 1px solid #f8bbd0;
        }

        .cart-item-info {
            display: flex;
            flex-direction: column;
        }

        .cart-item-name {
            font-weight: 700;
            color: #4a0024;
            font-size: 0.9rem;
        }

        .cart-item-detail {
            font-size: 0.75rem;
            color: #ad1457;
        }

        .cart-item-price {
            font-weight: 700;
            color: #c2185b;
            font-size: 0.9rem;
        }

        .delete-btn {
            background: none;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            padding: 5px;
            border-radius: 50%;
            transition: all 0.15s ease;
            color: #e91e63;
        }

        .delete-btn:hover {
            background: #fce4ec;
        }

        .empty-cart {
            text-align: center;
            color: #d81b60;
            padding: 15px;
            font-style: italic;
            font-size: 0.9rem;
        }

        .total-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fce4ec;
            border-radius: 15px;
            padding: 14px 18px;
            font-weight: 700;
            font-size: 1.1rem;
            color: #4a0024;
        }

        .total-amount {
            font-weight: 800;
            color: #c2185b;
        }

        .footer-text {
            text-align: center;
            margin-top: 15px;
            font-size: 0.75rem;
            color: #c2185b;
        }

        /* Scrollbar */
        .cart-items::-webkit-scrollbar {
            width: 5px;
        }

        .cart-items::-webkit-scrollbar-track {
            background: #fce4ec;
            border-radius: 10px;
        }

        .cart-items::-webkit-scrollbar-thumb {
            background: #f48fb1;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>Dinda</h1>
            <p class="subtitle">
                <span class="emoji">💖</span> Catatan Keuangan Jajan <span class="emoji">🍿</span>
            </p>
        </div>

        <!-- Menu Pilihan -->
        <div class="menu-section">
            <p class="menu-title">🍴 Pilih Menu Jajan</p>
            <div class="menu-grid" id="menuGrid">
                <!-- Menu akan di-generate oleh JavaScript -->
            </div>
        </div>

        <!-- Jumlah / Quantity -->
        <div class="qty-section">
            <span class="qty-label">🔢 Jumlah</span>
            <div class="qty-control">
                <button class="qty-btn" id="qtyMinus">−</button>
                <span id="quantityDisplay">1</span>
                <button class="qty-btn" id="qtyPlus">+</button>
            </div>
        </div>

        <!-- Tombol Tambah -->
        <button class="add-btn" id="addToCartBtn">
            ✨ Tambahkan ke Dinda ✨
        </button>

        <!-- Keranjang -->
        <div class="cart-section">
            <div class="cart-header">
                <span class="cart-title">🛒 Daftar Jajan</span>
                <button class="reset-btn" id="resetCartBtn">🔄 Reset</button>
            </div>
            <ul class="cart-items" id="cartList">
                <li class="empty-cart">Belum ada jajan nih... 🥺</li>
            </ul>
            <div class="total-section">
                <span>💰 Total</span>
                <span class="total-amount" id="totalPrice">Rp0</span>
            </div>
        </div>

        <p class="footer-text">💝 Dinda • Kelola Jajanmu dengan Cantik</p>
    </div>

    <script>
        (function() {
            // ==================== DATA MENU ====================
            const menuItems = [
                { name: "Sosis", price: 3500, icon: "🌭" },
                { name: "Keju", price: 3000, icon: "🧀" },
                { name: "Kebab", price: 6000, icon: "🥙" },
                { name: "Seblak", price: 5000, icon: "🍲" }
            ];

            // ==================== STATE ====================
            let selectedMenu = null;
            let quantity = 1;
            let cart = []; // array of { name, price, icon, qty }

            // ==================== DOM ELEMENTS ====================
            const menuGrid = document.getElementById('menuGrid');
            const quantityDisplay = document.getElementById('quantityDisplay');
            const qtyMinusBtn = document.getElementById('qtyMinus');
            const qtyPlusBtn = document.getElementById('qtyPlus');
            const addToCartBtn = document.getElementById('addToCartBtn');
            const cartListEl = document.getElementById('cartList');
            const totalPriceEl = document.getElementById('totalPrice');
            const resetCartBtn = document.getElementById('resetCartBtn');

            // ==================== FUNCTIONS ====================

            // Render menu buttons
            function renderMenuGrid() {
                menuGrid.innerHTML = '';
                menuItems.forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'menu-card';
                    card.innerHTML = `
                        <span class="menu-icon">${item.icon}</span>
                        <span class="menu-name">${item.name}</span>
                        <span class="menu-price">Rp${item.price.toLocaleString('id-ID')}</span>
                    `;

                    // Cek apakah menu ini sedang dipilih
                    if (selectedMenu && selectedMenu.name === item.name) {
                        card.classList.add('selected');
                    }

                    // Event klik
                    card.addEventListener('click', () => {
                        // Pilih menu ini
                        selectedMenu = { name: item.name, price: item.price, icon: item.icon };
                        // Reset quantity ke 1 setiap ganti menu
                        quantity = 1;
                        updateQuantityDisplay();
                        renderMenuGrid();
                    });

                    menuGrid.appendChild(card);
                });
            }

            // Update tampilan quantity
            function updateQuantityDisplay() {
                quantityDisplay.textContent = quantity;
            }

            // Set quantity dengan batasan
            function setQuantity(newQty) {
                if (newQty < 1) newQty = 1;
                if (newQty > 99) newQty = 99;
                quantity = newQty;
                updateQuantityDisplay();
            }

            // Hitung total
            function calculateTotal() {
                return cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            }

            // Update tampilan total
            function updateTotalDisplay() {
                const total = calculateTotal();
                totalPriceEl.textContent = `Rp${total.toLocaleString('id-ID')}`;
            }

            // Render keranjang
            function renderCart() {
                cartListEl.innerHTML = '';

                if (cart.length === 0) {
                    cartListEl.innerHTML = '<li class="empty-cart">Belum ada jajan nih... 🥺</li>';
                } else {
                    cart.forEach((item, index) => {
                        const li = document.createElement('li');
                        li.className = 'cart-item';
                        li.innerHTML = `
                            <div class="cart-item-info">
                                <span class="cart-item-name">${item.icon} ${item.name}</span>
                                <span class="cart-item-detail">${item.qty} × Rp${item.price.toLocaleString('id-ID')}</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="cart-item-price">Rp${(item.price * item.qty).toLocaleString('id-ID')}</span>
                                <button class="delete-btn" data-index="${index}" title="Hapus">🗑️</button>
                            </div>
                        `;
                        cartListEl.appendChild(li);
                    });

                    // Event listener untuk tombol hapus
                    document.querySelectorAll('.delete-btn').forEach(btn => {
                        btn.addEventListener('click', function() {
                            const index = parseInt(this.getAttribute('data-index'));
                            if (!isNaN(index)) {
                                cart.splice(index, 1);
                                renderCart();
                                updateTotalDisplay();
                            }
                        });
                    });
                }

                updateTotalDisplay();
            }

            // Tambah item ke keranjang
            function addToCart() {
                if (!selectedMenu) {
                    alert('Yuk pilih menu jajan dulu ya! 🍴');
                    return;
                }

                // Cek apakah item sudah ada di keranjang
                const existingIndex = cart.findIndex(item => item.name === selectedMenu.name);

                if (existingIndex !== -1) {
                    // Jika sudah ada, tambahkan quantity
                    cart[existingIndex].qty += quantity;
                } else {
                    // Jika belum ada, tambahkan item baru
                    cart.push({
                        name: selectedMenu.name,
                        price: selectedMenu.price,
                        icon: selectedMenu.icon,
                        qty: quantity
                    });
                }

                // Reset quantity ke 1 setelah menambahkan
                quantity = 1;
                updateQuantityDisplay();
                renderCart();
                renderMenuGrid();
            }

            // Reset keranjang
            function resetCart() {
                if (cart.length === 0) return;
                cart = [];
                renderCart();
            }

            // ==================== EVENT LISTENERS ====================
            qtyMinusBtn.addEventListener('click', () => {
                setQuantity(quantity - 1);
            });

            qtyPlusBtn.addEventListener('click', () => {
                setQuantity(quantity + 1);
            });

            addToCartBtn.addEventListener('click', addToCart);

            resetCartBtn.addEventListener('click', resetCart);

            // ==================== INISIALISASI ====================
            function init() {
                renderMenuGrid();
                updateQuantityDisplay();
                renderCart();
            }

            init();
        })();
    </script>
</body>
</html>
